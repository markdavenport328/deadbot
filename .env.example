# Canonical read store. CSV is the zero-setup default; PostgreSQL is the
# operational store for larger datasets and deployed environments.
DEADBOT_DATA_STORE=csv
# DEADBOT_DATA_STORE=postgres
# DEADBOT_DATABASE_URL=postgresql://deadbot:deadbot@localhost:5432/deadbot

# The first provider. More providers implement the same contract in deadbot/models.py.
DEADBOT_MODEL_PROVIDER=ollama
DEADBOT_OLLAMA_MODEL=qwen3:8b
DEADBOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Start non-thinking for responsive, reliable tool routing. Enable only after
# evaluating the slower reasoning loop on real Deadbot questions.
DEADBOT_OLLAMA_THINKING=false

# Hosted deployment option. Keep DEADBOT_MODEL_PROVIDER=ollama for local work.
# OPENAI_API_KEY should be set in the environment, never committed to Git.
# DEADBOT_MODEL_PROVIDER=openai
DEADBOT_OPENAI_MODEL=gpt-4o-mini
# Optional: use an OpenAI-compatible endpoint instead of api.openai.com.
# DEADBOT_OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Bound agent tool iterations. Keep this small for the read-only pilot.
DEADBOT_MAX_TOOL_ROUNDS=8

# The composer can only reorder/select server-validated result blocks. Keep it
# enabled for the browser experience; set false to use the deterministic order.

# Per-client-IP rate limit on POST /api/experience (each request calls the
# configured model). 0 or negative disables the limit. This is enforced per
# process instance only, not across Vercel function instances.
DEADBOT_RATE_LIMIT_PER_MINUTE=10

# Cap on how many of the browser-supplied conversation turns are replayed into
# the agent for a stateless follow-up request (the oldest turns are dropped).
DEADBOT_CONVERSATION_WINDOW=12
