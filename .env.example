# Canonical read store. SQLite is the default: build/deadbot.sqlite, built
# from data/canonical on first run and whenever the CSVs change.
# DEADBOT_DATA_STORE=sqlite
# DEADBOT_SQLITE_PATH=build/deadbot.sqlite
# Stored answers for repeated questions (a separate, writable file).
# DEADBOT_RESPONSE_CACHE_PATH=/tmp/deadbot-response-cache.sqlite

# The first provider. More providers implement the same contract in deadbot/models.py.
DEADBOT_MODEL_PROVIDER=ollama
DEADBOT_OLLAMA_MODEL=qwen3:8b
DEADBOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Start non-thinking for responsive, reliable tool routing. Enable only after
# evaluating the slower reasoning loop on real Deadbot questions.
DEADBOT_OLLAMA_THINKING=false

# Hosted deployment option. Keep DEADBOT_MODEL_PROVIDER=ollama for local work.
# OPENAI_API_KEY should be set in the environment, never committed to Git.
# DEADBOT_MODEL_PROVIDER=openai
DEADBOT_OPENAI_MODEL=gpt-4o-mini
# Optional: use an OpenAI-compatible endpoint instead of api.openai.com.
# DEADBOT_OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Stream model output so the chat answer can reach the visitor before the
# whole turn finishes. Defaults to true for openai, false otherwise.
# DEADBOT_MODEL_STREAMING=true

# Bound agent tool iterations. Keep this small for the read-only pilot.
DEADBOT_MAX_TOOL_ROUNDS=8

# --- Usage limits -----------------------------------------------------------
# Every question that reaches the model costs money. These keep one person or
# a simple script from running up a bill. Only questions that reach the model
# are counted: an answer served from the stored answers (the opening
# questions) is free. 0 turns any one limit off. A visitor over a limit gets
# HTTP 429 with a plain sentence saying when they can ask again.
#
# Per visitor. A signed cookie (deadbot_allowance: a random id and two counts,
# nothing personal) carries the count between function instances; it is signed
# with DEADBOT_NOTEBOOK_SECRET, and without that secret only the per-address
# limits below apply.
DEADBOT_VISITOR_LIMIT_PER_MINUTE=6
DEADBOT_VISITOR_LIMIT_PER_DAY=40
# Per client address, counted in each function instance's own memory (there
# is no shared store, so a new instance starts from zero). These bound
# requests that send no cookie; several people behind one address share them.
DEADBOT_RATE_LIMIT_PER_MINUTE=10
DEADBOT_RATE_LIMIT_PER_DAY=150
# Requests a day from one address that arrive without a valid cookie: first
# visits, and scripts that throw the cookie away to get a fresh allowance.
DEADBOT_NEW_VISITORS_PER_DAY=20
# Everything one function instance sends to the model in a day, whoever asks.
DEADBOT_INSTANCE_LIMIT_PER_DAY=500
# Cheap library reads per address per minute (grid reshapes, opened rows, a
# song's year, stored answers). No model call is involved.
DEADBOT_GRID_RATE_LIMIT_PER_MINUTE=60
# Read the visitor's address from the platform's forwarded headers. Defaults
# to true on Vercel, which overwrites those headers itself, and false
# everywhere else, where any client could write them.
# DEADBOT_TRUST_FORWARDED_IP=true

# Characters of earlier conversation the browser may send back with a
# question (the oldest turns are dropped first). The question itself is
# limited to 2,000 characters and one earlier turn to 8,000 by the request
# schema; the research notebook is signed, so only one this server made is read.
DEADBOT_CONVERSATION_MAX_CHARS=24000

# Hosted model calls. A call that sends nothing for this many seconds is cut
# off, and a failed call is tried again this many times: (retries + 1) x
# timeout has to fit inside the function's 60 seconds (vercel.json
# maxDuration). Raise the timeout if you raise the reasoning effort.
DEADBOT_MODEL_TIMEOUT_SECONDS=25
DEADBOT_MODEL_MAX_RETRIES=1
# Seconds a whole turn may take before it ends with a plain "that took too
# long" message, a little before the platform would cut the connection.
# Defaults to 55 for the openai provider and 0 (no budget) for a local model.
# Keep it a few seconds under maxDuration.
# DEADBOT_TURN_BUDGET_SECONDS=55

# --- Provider prompt cache ----------------------------------------------------
# The system prompt and tool schemas are the same for every visitor, so every
# visitor's model calls share one OpenAI prompt_cache_key and a first question
# can read the prefix an earlier visitor's call cached. One key holds about 15
# model calls a minute; above that, spread conversations over more keys.
DEADBOT_PROMPT_CACHE_SHARDS=1
# GPT-5.6 and later only: mark the end of the system prompt as an explicit
# cache breakpoint. Turn it on if first questions still show
# "first_call_cached_input_share": 0.0 in the turn metrics log while other
# visitors are active; turn it off again if answers start failing.
# DEADBOT_PROMPT_CACHE_BREAKPOINT=false

# Cap on how many of the browser-supplied conversation turns are replayed into
# the agent for a stateless follow-up request (the oldest turns are dropped).
DEADBOT_CONVERSATION_WINDOW=12

# Store composed answers to fresh questions (the opening chips above all) and
# serve them again until the data version or deployed commit changes.
DEADBOT_RESPONSE_CACHE=true
DEADBOT_RESPONSE_CACHE_TTL_SECONDS=604800

# Signs the research notebook that carries each turn's research to the next
# turn. Any long random string; the same value in every environment that
# serves or builds answers (Vercel: Production and Preview, build and
# runtime). Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset means follow-ups start from the transcript alone.
# DEADBOT_NOTEBOOK_SECRET=
