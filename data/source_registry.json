    {
      "source_id": "musicbrainz-api",
      "name": "MusicBrainz web service",
      "host_allowlist": ["musicbrainz.org"],
      "authority_level": "curated",
      "access_state": "allowed",
      "rights_state": "cleared",
      "review_state": "approved",
      "allowed_operations": ["search", "browse"],
      "operation_policies": {
        "search": {"methods": ["GET"], "paths": ["/ws/2/artist/"]},
        "browse": {"methods": ["GET"], "paths": ["/ws/2/release-group", "/ws/2/release"]}
      },
      "retention_policy": {
        "mode": "metadata_only",
        "store_content": false,
        "store_links": true,
        "max_retention_days": 3650
      },
      "rate_policy": {
        "requests_per_minute": 55,
        "burst": 1,
        "min_interval_seconds": 1,
        "retry_after_seconds": 30
      },
      "adapter_version": "musicbrainz-api-v1",
      "notes": "JSON web service only, one request per second, descriptive User-Agent required. Covers artist search plus release-group and release browse used by scripts/collect/fetch_musicbrainz_live_releases.py and fetch_musicbrainz_studio_releases.py. No cover art or annotation text is retrieved or stored. fetch_musicbrainz_song_works.py's /ws/2/work search is a separate, unverified gap tracked outside this entry."
    },
    {
      "source_id": "wikipedia-api",
      "name": "Wikipedia API (en)",
      "host_allowlist": ["en.wikipedia.org"],
      "authority_level": "curated",
      "access_state": "allowed",
      "rights_state": "restricted",
      "review_state": "approved",
      "allowed_operations": ["search", "read"],
      "operation_policies": {
        "search": {"methods": ["GET"], "paths": ["/w/api.php"]},
        "read": {"methods": ["GET"], "paths": ["/w/api.php"]}
      },
      "retention_policy": {
        "mode": "metadata_only",
        "store_content": false,
        "store_links": true,
        "max_retention_days": 3650
      },
      "rate_policy": {
        "requests_per_minute": 55,
        "burst": 1,
        "min_interval_seconds": 1,
        "retry_after_seconds": 30
      },
      "adapter_version": "wikipedia-api-v1",
      "notes": "JSON MediaWiki action API only, one request per second, descriptive User-Agent required. 'search' is action=query&list=search to resolve an ambiguous album title to the confidently correct article; 'read' is action=query&prop=revisions with rvslots=main to fetch that article's current wikitext. Used by scripts/collect/fetch_wikipedia_album_dates.py to sharpen imprecise official_releases.release_date values. Only the infobox 'Released' field is extracted and stored, verbatim, alongside article title, page id, revision id and URL; no other article text, images, or full wikitext is retained."
    }
,
