# What Vercel uploads and bundles into the Python function.
#
# Deadbot serves only PostgreSQL at request time (see deadbot/storage.py):
# the checked-in CSV and JSONL files are import inputs, not a serving
# fallback. Keeping them out of the deployment is what holds the upload
# under the 100 MB Hobby limit.

# Bulk research inputs. Imported into PostgreSQL by deadbot/postgres_import.py
# and by scripts/, neither of which runs on Vercel.
data/raw
data/canonical

# Repository material the deployed function never loads.
docs
tests
evals
scripts
.agents
.github

# Build artifacts of the TypeScript project reference, regenerated by the
# Vercel build command.
web/*.tsbuildinfo
