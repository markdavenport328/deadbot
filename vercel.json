{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix web ci && npm --prefix web run build",
  "functions": {
    "app.py": {
      "includeFiles": "{web/dist/index.html,web/dist/assets/**,web/dist/fonts/**}",
      "excludeFiles": "{data/raw/**,data/canonical/**,docs/**,tests/**,evals/**,scripts/**}",
      "maxDuration": 60
    }
  }
}
